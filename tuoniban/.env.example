# 託你辦的環境設定範例。這個檔案會進 repo，不要在這裡填真的金鑰。
#
# 什麼時候需要：
# - 本機 `npm run dev`：不需要任何設定，可以不建立 .env。
# - 本機 `npm start`（手機透過 Wi-Fi 或 HTTPS tunnel 連進來）：複製成 .env，再填 PUBLIC_ORIGIN 等值。
#     cp .env.example .env
#   .env 已列在 .gitignore，不會被 commit。
# - GCP VM：deploy/setup-vm.sh 會自動產生 /etc/tuoniban.env，不用手動複製。
#
# 格式：每行一個 KEY=值；註解要獨立一行，不要寫在值的後面；值留空等於沒設定。
# 改完設定要重新啟動伺服器（VM 上是 sudo systemctl restart tuoniban）。

# ===== 部署時一定要設 =====

# 正式環境模式。VM 的 systemd 服務檔已經設定好，這裡不用寫；本機開發不要設。
# 設了以後，DEMO_MODE、PUBLIC_ORIGIN、SESSION_SECRET 少一個就無法啟動。
# NODE_ENV=production

# 一定要是 true：這個作品只跑虛構的展示資料（規格 §13.1）。設成其他值會無法啟動。
DEMO_MODE=true

# 手機打開的網址的 origin：https://主機名稱，結尾不加 /，要和瀏覽器網址列一字不差。
# QR Code 和協助連結都用它產生，會改資料的請求也只接受這個來源；設錯時所有儲存、送出都會失敗。
# 沒有網域時用 VM 外部 IP，把點換成橫線再加 .sslip.io，例如 https://34-80-1-2.sslip.io
# 不設時：本機 npm run dev 是 http://localhost:5173，npm start 是 http://localhost:8787。
PUBLIC_ORIGIN=

# 簽 session cookie 的金鑰，至少 16 個字元，只放在伺服器上，不要 commit。
# 產生方式：openssl rand -hex 32
# 正式環境或 PUBLIC_ORIGIN 是 https 時一定要設；本機不設會每次啟動隨機產生，重開後要重新選身分。
SESSION_SECRET=

# ===== 選填，不設就用預設值 =====

# 伺服器監聽的 port，預設 8787。VM 上改了要一起改 /etc/caddy/Caddyfile 的 reverse_proxy。
# PORT=8787

# SQLite 資料庫檔案位置，預設 .data/tuoniban.db（相對於啟動時所在的資料夾）。要放在重開機不會不見的磁碟上。
# DATABASE_PATH=/var/lib/tuoniban/data/tuoniban.db

# 附件存放的私有資料夾，預設 .data/uploads。不能放在網站檔案資料夾（dist/web）裡面。
# PRIVATE_UPLOAD_DIR=/var/lib/tuoniban/data/uploads

# 改用 Postgres（選用，VM 部署用不到）。設了就不用上面兩個 SQLite 設定，附件改存進資料庫。
# 要以 postgres:// 或 postgresql:// 開頭。
# DATABASE_URL=postgres://USER:PASSWORD@HOST:5432/DBNAME

# 網站檔案所在的資料夾。npm start 預設用 dist/web（npm run build 產生），通常不用設。
# STATIC_DIR=dist/web

# 附件大小上限（byte），預設 5242880，也就是規格固定的 5 MiB；畫面上的說明會跟著變。通常不要改。
# MAX_UPLOAD_BYTES=5242880

# 前面有幾層反向代理，要填數字（例如 1），不能填 true。預設關閉。
# 目前程式沒有用到來源 IP，cookie 的 Secure 也是看 PUBLIC_ORIGIN，所以在 Caddy 後面不設也能正常運作。
# TRUST_PROXY=1

# 每個 session 每分鐘最多幾次「領取協助碼」和「上傳附件」，預設 30 和 20。
# RATE_LIMIT_REDEEM_PER_MINUTE=30
# RATE_LIMIT_UPLOAD_PER_MINUTE=20

# 只在本機除錯時設 true：錯誤訊息會寫進日誌，可能含使用者輸入的內容。部署時不要開。
# DEBUG_ERRORS=true

# VERCEL、VERCEL_PROJECT_PRODUCTION_URL、K_SERVICE 是 Vercel 和 Cloud Run 平台自動設定的，
# 我們不用這兩個平台，不要手動設。
