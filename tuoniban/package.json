{
  "name": "tuoniban",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "license": "AGPL-3.0-only",
  "description": "託你辦｜授權協作申辦與預約平台：申請者產生 QR Code，代辦者掃碼接續固定範例表單並模擬送出",
  "engines": {
    "node": ">=22.13"
  },
  "scripts": {
    "dev": "concurrently -k -n api,web -c cyan,green \"npm:dev:api\" \"npm:dev:web\"",
    "dev:api": "tsx watch --env-file-if-exists=.env server/src/main.ts",
    "dev:web": "vite",
    "build": "npm run typecheck && npm run build:web && npm run build:server",
    "build:web": "vite build",
    "build:server": "esbuild server/src/main.ts --bundle --platform=node --format=esm --packages=external --outfile=dist-server/main.mjs",
    "start": "node --env-file-if-exists=.env dist-server/main.mjs",
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p e2e/tsconfig.json && vue-tsc --noEmit -p web/tsconfig.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "demo:reset": "tsx --env-file-if-exists=.env server/src/reset-cli.ts",
    "licenses": "node scripts/list-licenses.mjs"
  },
  "dependencies": {
    "cookie": "2.0.2",
    "express": "5.3.0",
    "jsqr": "1.4.0",
    "multer": "2.5.0",
    "pg": "8.23.1",
    "qrcode": "1.5.4",
    "vue": "3.5.45",
    "vue-router": "5.4.0",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.14.0",
    "@playwright/test": "1.65.0",
    "@types/express": "5.0.6",
    "@types/multer": "2.3.0",
    "@types/node": "26.6.6",
    "@types/pg": "8.23.1",
    "@types/qrcode": "1.5.6",
    "@types/supertest": "7.2.1",
    "@vitejs/plugin-vue": "6.0.10",
    "@vue/test-utils": "2.5.1",
    "concurrently": "10.0.6",
    "embedded-postgres": "18.6.0-beta.19",
    "esbuild": "0.28.2",
    "jsdom": "31.0.0",
    "supertest": "7.3.1",
    "tsx": "4.23.15",
    "typescript": "6.0.3",
    "vite": "8.3.6",
    "vitest": "5.1.0",
    "vue-tsc": "3.3.14"
  }
}
